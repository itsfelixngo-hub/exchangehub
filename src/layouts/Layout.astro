---
import { siteOrigin, SITE_NAME, SITE_ALTERNATE_NAME } from "../lib/site";
import { resolveVisitorLocale } from "../lib/geo";
import "../styles/fonts.css";
import "../styles/components.css";
import "../styles/responsive.css";

interface Props {
  title: string;
  description: string;
  path: string;
  breadcrumbName?: string;
  /** One level between the home page and this one, e.g. VND above VND/USD. */
  breadcrumbParent?: { name: string; path: string };
  extraSchemaNodes?: unknown[];
  ogImage?: string;
  /** Ask search engines to leave this page out — see pairIsNoindex(). */
  noindex?: boolean;
}

const {
  title, description, path, breadcrumbName, breadcrumbParent,
  extraSchemaNodes = [], ogImage, noindex = false,
} = Astro.props;

// The CJK faces are the one part still served by Google. Unlike the latin
// families in styles/fonts.css they are not worth self-hosting: Noto Sans SC
// and JP are split into hundreds of unicode-range subsets and run to hundreds
// of megabytes in full, and they are only ever applied to Google-translated
// text anyway — see the html[lang^="zh"] / [lang^="ja"] rules in Header.astro.
// So the stylesheet is requested only for a visitor who is already on Chinese
// or Japanese; picking either by hand injects it at that point (Header.astro).
const visitorLang = resolveVisitorLocale(Astro.request, Astro.cookies.get("site_lang")?.value).lang;
const needsCjkFonts = visitorLang === "zh-CN" || visitorLang === "ja";

const siteBaseUrl = siteOrigin(Astro.request, Astro.url);
const canonicalUrl = siteBaseUrl + path;
const logoUrl = `${siteBaseUrl}/ratehub-2c.png`;
const ogImageUrl = ogImage ?? `${siteBaseUrl}/og-image.png`;
// Only the built-in card has known dimensions. Facebook renders a small card
// on first share when it has to fetch the image to measure it, so they are
// worth stating -- but stating them for a caller's own image would be a guess.
const isDefaultOgImage = ogImage === undefined;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteBaseUrl}/#organization`,
      name: SITE_NAME,
      alternateName: SITE_ALTERNATE_NAME,
      url: siteBaseUrl,
      logo: { "@type": "ImageObject", url: logoUrl },
    },
    {
      // Google picks the name it shows under the search result from here. The
      // brand in the page copy is "ExchangeHub" while the domain reads
      // "ratehubfx.com"; without alternateName the two look like unrelated
      // signals and Google substitutes a name of its own choosing.
      "@type": "WebSite",
      "@id": `${siteBaseUrl}/#website`,
      name: SITE_NAME,
      alternateName: SITE_ALTERNATE_NAME,
      url: siteBaseUrl,
      publisher: { "@id": `${siteBaseUrl}/#organization` },
      inLanguage: "en",
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description,
      isPartOf: { "@id": `${siteBaseUrl}/#website` },
      publisher: { "@id": `${siteBaseUrl}/#organization` },
      breadcrumb: { "@id": `${canonicalUrl}#breadcrumb` },
      inLanguage: "en",
    },
    {
      // Three levels where a parent is given — home, the currency hub, the
      // pair — so the trail Google prints under the result mirrors the way the
      // pages actually nest rather than flattening every page onto the root.
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Exchange Rates", item: siteBaseUrl },
        ...(breadcrumbParent
          ? [{
              "@type": "ListItem",
              position: 2,
              name: breadcrumbParent.name,
              item: siteBaseUrl + breadcrumbParent.path,
            }]
          : []),
        { "@type": "ListItem", position: breadcrumbParent ? 3 : 2, name: breadcrumbName ?? title },
      ],
    },
    ...extraSchemaNodes,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex
        ? "noindex,follow"
        : "index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1"}
    />
    <link rel="canonical" href={canonicalUrl} />
    <!-- Generated from the site logo (public/ratehub-2b-icon.png), cropped to
         the "fx" mark — the bars beside it turn to mush at 16px. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={title} />
    {isDefaultOgImage && (
      <>
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <!-- The page is served in English and translated in the browser by Google's
         widget, which rewrites html[lang] itself. There is no separate URL per
         language, so there is nothing for og:locale:alternate or hreflang to
         point at — claiming otherwise would send crawlers to pages that do not
         exist. -->
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <!-- X falls back to og:image, but other scrapers reading the card tags
         (Slack, Discord, LinkedIn) do not all do that. -->
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={title} />
    <!-- The faces themselves are declared in src/styles/fonts.css, which rides
         the same bundle as the rest of the CSS. Only the two that carry the
         first screen are preloaded: Manrope is the body face set below, Space
         Grotesk every heading above the fold. `font-display: swap` paints the
         fallback immediately, so what a preload buys is not the first paint
         but the swap -- without it the largest text block repaints when the
         face lands, and LCP is measured at that repaint rather than the paint
         before it. The remaining faces (the other subsets, Source Sans 3, IBM
         Plex Mono) are left to the normal unicode-range fetch: preloading a
         file the page may not draw with costs more than it saves. -->
    <link rel="preload" as="font" type="font/woff2" crossorigin
      href="/fonts/manrope-400-800-latin.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin
      href="/fonts/space-grotesk-500-700-latin.woff2" />
    {needsCjkFonts && (
      <link
        id="cjk-fonts"
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;600;700&display=swap"
      />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <style is:global>
      * { box-sizing: border-box; }
      body { margin: 0; font-family: 'Manrope', Arial, sans-serif; }
      /* Nothing on the page is meant to scroll sideways; a single element
         that overshoots the viewport would otherwise shrink the whole layout
         on a phone (the visual viewport zooms out to fit it). */
      html, body { overflow-x: hidden; max-width: 100%; }
      table { border-collapse: collapse; width: 100%; }
      a { text-decoration: none; color: inherit; }
      .picker-scroll { scrollbar-width: thin; scrollbar-color: #3a332f transparent; }
      .picker-scroll::-webkit-scrollbar { width: 6px; }
      .picker-scroll::-webkit-scrollbar-track { background: transparent; }
      .picker-scroll::-webkit-scrollbar-thumb { background: #3a332f; border-radius: 3px; }
      .picker-scroll::-webkit-scrollbar-thumb:hover { background: #57504c; }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
