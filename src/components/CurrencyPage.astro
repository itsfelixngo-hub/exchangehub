---
// `/vnd` — the hub above every `/vnd-*` pair page.
//
// It exists for two reasons. For a reader, one page that answers "what is the
// dong worth against everything" rather than making them guess pair URLs. For
// a crawler, a level between the home page and 50-odd pair pages: without it
// every pair hangs directly off the root, which is the flat shape that reads
// as a page generator rather than a site.
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import BackToTop from "./BackToTop.astro";
import SortFilterBar from "./SortFilterBar.astro";
import { buildMenuModel } from "../lib/menu";
import { buildPairMovers, buildQuoteRateRows } from "../lib/home";
import { configCurrencies, currencyProfile, currencyUrl, pairUrl } from "../lib/config";
import { flagSrc } from "../lib/flags";
import { resolveVisitorLocale } from "../lib/geo";
import { siteOrigin } from "../lib/site";

interface Props {
  code: string;
}

const { code } = Astro.props;
const profile = currencyProfile(code);
const menu = buildMenuModel(code);
const pairMovers = await buildPairMovers(6, code);
const locale = resolveVisitorLocale(Astro.request, Astro.cookies.get("site_lang")?.value);

// One call gives every `code -> X` rate with its change and sparkline; the
// reverse direction is the same set of currencies read the other way, so it
// needs no second pass over the data.
const rows = await buildQuoteRateRows(code);
const others = configCurrencies().filter((c) => c !== code);
// Not every configured currency has a flag file; the heading and the chips
// read fine without one, so a missing flag is skipped rather than defaulted.
const flag = flagSrc(code);

const title = `${code} Exchange Rates — ${profile.name} Against Every Currency`;
const description = `Live ${code} exchange rates: the ${profile.name} against ${others.length} currencies, `
  + `with change, charts and a converter on every pair page.`;

const siteBaseUrl = siteOrigin(Astro.request, Astro.url);
const canonical = siteBaseUrl + currencyUrl(code);

// `order` is the order the rows arrive in — configCurrencies() order, majors
// first. The rest sort on the data attributes each row carries.
const PAIR_SORT_OPTIONS = [
  { value: "order-asc", label: "Default" },
  { value: "code-asc", label: "Currency A-Z" },
  { value: "code-desc", label: "Currency Z-A" },
  { value: "change-desc", label: "Change: high to low" },
  { value: "change-asc", label: "Change: low to high" },
  { value: "rate-desc", label: "Rate: high to low" },
  { value: "rate-asc", label: "Rate: low to high" },
];

// An ItemList of the pair pages below: it states the hub-to-pair relationship
// in the markup rather than leaving it to be inferred from the links.
const extraSchemaNodes = [
  {
    "@type": "ItemList",
    "@id": `${canonical}#pairs`,
    name: `${code} currency pairs`,
    numberOfItems: rows.length,
    itemListElement: rows.map((row, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: `${code}/${row.target}`,
      url: siteBaseUrl + row.href,
    })),
  },
];
---

<Layout
  title={title}
  description={description}
  path={currencyUrl(code)}
  breadcrumbName={`${code} rates`}
  extraSchemaNodes={extraSchemaNodes}
>
  <div>
    <Header pairMovers={pairMovers} active="Rates" autoLang={locale.lang} />

    <div class="page-pad section-pad" style="background:radial-gradient(1100px 560px at 82% -10%, rgba(225,29,63,0.22), transparent 60%), #0c0b0d; padding:48px 40px 80px; font-family:'Manrope', Arial, sans-serif;">
      <div style="max-width:1160px; margin:0 auto;">

        <nav aria-label="Breadcrumb" style="font-size:13px; color:#8b857f; margin-bottom:18px;">
          <a href="/" style="color:#8b857f;">Exchange Rates</a>
          <span style="margin:0 8px;">/</span>
          <span style="color:#f5f2f1;">{code}</span>
        </nav>

        <div style="display:flex; align-items:center; gap:16px; margin-bottom:14px;">
          {flag && <img src={flag} alt="" width="44" height="44" style="display:block; border-radius:8px;" />}
          <h1 class="lead-title" style="font-family:'Space Grotesk', Arial, sans-serif; font-size:38px; color:#f5f2f1; margin:0; line-height:1.1;">
            {code} exchange rates
          </h1>
        </div>
        <p style="font-size:16px; line-height:1.7; color:#a79fa0; margin:0 0 34px; max-width:760px;">
          {profile.name} ({code}) is the currency of {profile.region} and a {profile.role}. These
          pages cover {profile.use}. Every row below opens a full pair page with a converter,
          a chart, high-low statistics and the reverse quote.
        </p>

        <h2 style="font-family:'Space Grotesk', Arial, sans-serif; font-size:20px; color:#f5f2f1; margin:0 0 4px;">
          1 {code} in other currencies
        </h2>
        <div style="width:26px; height:2px; background:#e11d3f; margin-bottom:18px;"></div>

        {rows.length > 0 && (
          <div style="margin-bottom:16px;">
            <SortFilterBar id="pairs-sf" options={PAIR_SORT_OPTIONS} placeholder="Filter currencies..." />
          </div>
        )}

        <div style="background:#fff; border-radius:18px; padding:8px 4px; box-shadow:0 24px 60px rgba(0,0,0,0.35); overflow-x:auto;">
          <table style="min-width:560px;">
            <thead>
              <tr style="text-align:left; color:#8b857f; font-size:12px; text-transform:uppercase; letter-spacing:.05em;">
                <th style="padding:12px 16px;">Pair</th>
                <th style="padding:12px 16px;">Rate</th>
                <th style="padding:12px 16px;">Change</th>
                <th style="padding:12px 16px;">Trend</th>
                <th style="padding:12px 16px;">Reverse</th>
              </tr>
            </thead>
            <tbody id="pairs-tbody">
              {rows.map((row) => (
                <tr
                  data-pair-row
                  data-sf-search={`${code} ${row.target} ${currencyProfile(row.target).name}`.toLowerCase()}
                  data-sf-code={row.target}
                  data-sf-rate={row.rateValue}
                  data-sf-change={row.changePct}
                  style="border-top:1px solid #eee9e6;"
                >
                  <td style="padding:12px 16px;">
                    <a href={row.href} style="color:#0c0b0d; font-weight:700; font-family:'IBM Plex Mono', monospace;">
                      {code}/{row.target}
                    </a>
                  </td>
                  <td style="padding:12px 16px; font-family:'IBM Plex Mono', monospace; color:#0c0b0d;">{row.rate}</td>
                  <td style={`padding:12px 16px; font-family:'IBM Plex Mono', monospace; color:${row.direction === "up" ? "#16a34a" : row.direction === "down" ? "#e11d3f" : "#8b857f"};`}>
                    {row.changeLabel}
                  </td>
                  <td style="padding:8px 16px;">
                    <svg viewBox="0 0 120 30" width="120" height="30" aria-hidden="true">
                      <polyline
                        points={row.points}
                        fill="none"
                        stroke={row.direction === "up" ? "#16a34a" : row.direction === "down" ? "#e11d3f" : "#8b857f"}
                        stroke-width="2"
                      />
                    </svg>
                  </td>
                  <td style="padding:12px 16px;">
                    <a href={pairUrl(row.target, code)} style="color:#e11d3f; font-family:'IBM Plex Mono', monospace; font-size:13px;">
                      {row.target}/{code}
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          <p id="pairs-empty" hidden style="padding:16px; margin:0; color:#8b857f; font-size:14px;">
            No currencies match your filter.
          </p>
        </div>

        {rows.length === 0 && (
          <p style="font-size:15px; color:#a79fa0; margin:18px 0 0;">
            No stored rates for {code} yet. The fetcher writes every five minutes; this page fills in
            on the next cycle.
          </p>
        )}

        <h2 style="font-family:'Space Grotesk', Arial, sans-serif; font-size:20px; color:#f5f2f1; margin:40px 0 4px;">
          Other currencies
        </h2>
        <div style="width:26px; height:2px; background:#e11d3f; margin-bottom:18px;"></div>
        <div style="display:flex; flex-wrap:wrap; gap:10px;">
          {others.map((other) => {
            const otherFlag = flagSrc(other);
            return (
              <a
                href={currencyUrl(other)}
                style="display:inline-flex; align-items:center; gap:8px; padding:8px 14px; border-radius:999px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); color:#f5f2f1; font-size:13px; font-family:'IBM Plex Mono', monospace;"
              >
                {otherFlag && <img src={otherFlag} alt="" width="18" height="18" style="display:block; border-radius:3px;" loading="lazy" decoding="async" />}
                {other}
              </a>
            );
          })}
        </div>

      </div>
    </div>

    <Footer menu={menu} />
    <BackToTop />
  </div>
</Layout>

<script>
  import { wireSortFilter } from "../scripts/sort-filter";

  const tbody = document.getElementById("pairs-tbody");
  const empty = document.getElementById("pairs-empty");
  if (tbody) {
    wireSortFilter({
      bar: document.getElementById("pairs-sf"),
      container: tbody,
      itemSelector: "[data-pair-row]",
      countNoun: "currencies",
      onApply: (matched, all) => {
        for (const row of all) row.style.display = "none";
        // Table rows have no single display value that works everywhere —
        // clearing the property lets the UA's `table-row` apply again.
        for (const row of matched) row.style.display = "";
        if (empty) empty.hidden = matched.length > 0;
      },
    });
  }
</script>
