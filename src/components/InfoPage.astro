---
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import BackToTop from "./BackToTop.astro";
import { buildMenuModel } from "../lib/menu";
import { buildPairMovers } from "../lib/home";
import { resolveVisitorLocale } from "../lib/geo";
import { CONTACT_EMAIL, INFO_CONTENT_LAST_MODIFIED, INFO_PAGES, type InfoSlug } from "../lib/info";

interface Props {
  slug: InfoSlug;
}

const { slug } = Astro.props;
const page = INFO_PAGES[slug];
// A dated policy is what an ad network's reviewer looks for, and the privacy
// copy promises the date is here. Same constant the sitemap reports, so the
// page and the sitemap can never disagree about it.
const lastUpdated = new Date(`${INFO_CONTENT_LAST_MODIFIED}T00:00:00Z`).toLocaleDateString("en-GB", {
  day: "numeric", month: "long", year: "numeric", timeZone: "UTC",
});
const menu = buildMenuModel();
const pairMovers = await buildPairMovers();
const locale = resolveVisitorLocale(Astro.request, Astro.cookies.get("site_lang")?.value);

// The copy is plain strings. Two things in it become links: the contact
// address wherever it appears, and `[label](https://…)` for an outside source.
type Segment = { text: string } | { text: string; href: string };
const escapedEmail = CONTACT_EMAIL.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
const LINKS = new RegExp(`\\[([^\\]]+)\\]\\((https?://[^)\\s]+)\\)|(${escapedEmail})`, "g");

function segments(text: string): Segment[] {
  const out: Segment[] = [];
  let last = 0;
  for (const match of text.matchAll(LINKS)) {
    if (match.index > last) out.push({ text: text.slice(last, match.index) });
    out.push(match[3]
      ? { text: CONTACT_EMAIL, href: `mailto:${CONTACT_EMAIL}` }
      : { text: match[1], href: match[2] });
    last = match.index + match[0].length;
  }
  if (last < text.length) out.push({ text: text.slice(last) });
  return out;
}

// About and Contact are in the header bar; the other policy pages are not.
const headerActive = slug === "about" ? "About" : slug === "contact" ? "Contact" : "none";
---

<Layout
  title={page.title}
  description={page.description}
  path={`/${slug}`}
  breadcrumbName={page.heading}
>
  <div>
    <Header pairMovers={pairMovers} active={headerActive} autoLang={locale.lang} />

    <div class="page-pad section-pad" style="background:#0c0b0d; padding:56px 40px 80px; font-family:'Manrope', Arial, sans-serif;">
      <div style="max-width:760px; margin:0 auto;">
        <span style="display:inline-block; background:rgba(225,29,63,0.14); border:1px solid rgba(225,29,63,0.4); color:#ff4d6d; font-size:12px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; padding:6px 12px; border-radius:999px; margin-bottom:18px;">
          {page.eyebrow}
        </span>
        <h1 class="lead-title" style="font-family:'Space Grotesk', Arial, sans-serif; font-size:36px; color:#f5f2f1; margin:0 0 10px; line-height:1.15;">{page.heading}</h1>
        <p style="font-size:13px; color:#6f6869; margin:0 0 32px;">
          Last updated <time datetime={INFO_CONTENT_LAST_MODIFIED}>{lastUpdated}</time>
        </p>

        {page.sections.map((section, index) => (
          <div style={`margin-bottom:${index === page.sections.length - 1 ? "8px" : "32px"};`}>
            <h2 style="font-family:'Space Grotesk', Arial, sans-serif; font-size:19px; color:#f5f2f1; margin:0 0 6px;">{section.heading}</h2>
            <div style="width:26px; height:2px; background:#e11d3f; margin-bottom:14px;"></div>
            {section.body.map((paragraph, paragraphIndex) => (
              <p style={`font-size:15.5px; line-height:1.75; color:#a79fa0; margin:0 0 ${paragraphIndex === section.body.length - 1 ? "0" : "14px"};`}>
                {segments(paragraph).map((part) => ("href" in part
                  ? <a href={part.href} rel={part.href.startsWith("http") ? "noopener" : undefined} style="color:#ff4d6d;">{part.text}</a>
                  : part.text))}
              </p>
            ))}
          </div>
        ))}
        <slot />
      </div>
    </div>

    <Footer menu={menu} secondary="company" />
    <BackToTop />
  </div>
</Layout>
