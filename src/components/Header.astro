---
import type { PairMovers } from "../lib/home";
import type { SupportedLanguage } from "../lib/geo";

interface Props {
  pairMovers: PairMovers;
  /** "none" for pages that aren't one of the nav destinations (the policy
   *  pages), so nothing in the bar is highlighted. */
  active?: "ExchangeHub" | "Rates" | "Charts" | "Convert" | "Analysis" | "none";
  autoLang?: SupportedLanguage;
}

const { pairMovers, active = "ExchangeHub", autoLang = "en" } = Astro.props;

// Round flags from circle-flags (HatScripts, MIT — see public/flags/LICENSE.md).
// Drawn as circles rather than rectangles cropped into one, so nothing that
// identifies a flag gets cut off the way the US canton or China's stars do
// under a circular crop of a rectangular flag.
const LANGUAGES: { code: SupportedLanguage; label: string; flag: string }[] = [
  { code: "en", label: "English", flag: "/flags/us.svg" },
  { code: "vi", label: "Tiếng Việt", flag: "/flags/vn.svg" },
  { code: "zh-CN", label: "中文", flag: "/flags/cn.svg" },
  { code: "ja", label: "日本語", flag: "/flags/jp.svg" },
  { code: "es", label: "Español", flag: "/flags/es.svg" },
  { code: "fr", label: "Français", flag: "/flags/fr.svg" },
];
const tickerItems = [...pairMovers.up, ...pairMovers.down, ...pairMovers.flat].slice(0, 10);
const navLinks: { label: string; href: string }[] = [
  { label: "ExchangeHub", href: "/" },
  { label: "Rates", href: "/#today-rates" },
  { label: "Charts", href: "/chart" },
  { label: "Convert", href: "/#converter" },
  // Points at the analysis index. It used to point at /about, which promised
  // market commentary and delivered the company page — and lit this tab up
  // whenever someone was reading About. About lives in the footer with the
  // other company pages.
  { label: "Analysis", href: "/analysis" },
];
---

<div style="background:#0f0e0d;">
  <div class="page-pad hdr-meta" style="max-width:1240px; margin:0 auto; padding:10px 40px; display:flex; justify-content:space-between; border-bottom:1px solid rgba(255,255,255,0.08); font-family:'Source Sans 3', Arial, sans-serif; font-size:12px; color:rgba(255,255,255,0.55); letter-spacing:.03em;">
    <span id="local-date"></span>
    <span id="local-clock"></span>
  </div>
  <div style="border-top:1px solid #0f0e0d; border-bottom:1px solid #0f0e0d; background:#0f0e0d;">
    <div class="page-pad hdr-main" style="max-width:1240px; margin:0 auto; padding:0 40px; display:flex; align-items:center; justify-content:space-between; gap:24px; height:64px; font-family:'Source Sans 3', Arial, sans-serif;">
      <div class="hdr-logo" style="display:flex; align-items:center; flex:0 0 auto;">
        <a href="/" style="display:inline-flex; align-items:center;">
          <img src="/ratehub-2b-icon.png" alt="ExchangeHub" style="height:30px; width:auto; display:block;" />
        </a>
      </div>
      <div class="hdr-nav" style="display:flex; align-items:center; gap:32px;">
        {navLinks.map((link) => (
          <a
            href={link.href}
            style={`color:${link.label === active ? "#fff" : "rgba(255,255,255,0.7)"}; font-size:14px; font-weight:${link.label === active ? "600" : "400"};`}
          >
            {link.label}
          </a>
        ))}
      </div>
      <div style="display:flex; align-items:center; gap:10px; flex:0 0 auto;">
        <div class="translate-widget" style="position:relative;">
          <button type="button" id="translate-toggle" class="translate-toggle" data-auto-lang={autoLang} style="display:inline-flex; align-items:center; padding:0; background:transparent; border:none; cursor:pointer;">
            <img
              id="translate-toggle-flag"
              src={(LANGUAGES.find((l) => l.code === autoLang) ?? LANGUAGES[0]).flag}
              alt="" width="26" height="26" style="display:block;"
            />
          </button>
          <div class="translate-menu" style="display:none; position:absolute; right:0; top:calc(100% + 8px); z-index:1100; width:180px; padding:8px; border-radius:10px; background:#fff; box-shadow:0 16px 40px rgba(15,23,42,.14);">
            {LANGUAGES.map((lang) => (
              <button
                type="button"
                class="translate-option"
                data-lang={lang.code}
                data-flag={lang.flag}
                style="display:flex; align-items:center; gap:8px; width:100%; border:0; background:transparent; border-radius:8px; padding:7px 8px; color:#1a1614; cursor:pointer; text-align:left; font-size:13px;"
              >
                <img src={lang.flag} alt="" width="20" height="20" class="flag-ico" loading="lazy" decoding="async" />
                {lang.label}
              </button>
            ))}
          </div>
          <div id="google_translate_element" style="position:absolute; width:1px; height:1px; overflow:hidden; opacity:0; pointer-events:none;"></div>
        </div>
        <button
          type="button"
          id="nav-toggle"
          class="hdr-menu"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="nav-drawer"
          style="display:none; width:44px; height:44px; margin-right:-10px; border-radius:999px; background:transparent; border:none; align-items:center; justify-content:center; cursor:pointer;"
        >
          {/* Both icons ship; `aria-expanded` picks which one shows, so the
              open drawer offers a way to close itself rather than leaving the
              same hamburger sitting over it. */}
          <svg class="hdr-menu-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          <svg class="hdr-menu-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </div>
    </div>
    <!-- Only ever shown below the tablet breakpoint, where the bar has
         dropped some or all of the destinations. -->
    <div
      id="nav-drawer"
      class="hdr-drawer page-pad"
      data-open="false"
      style="display:none; flex-direction:column; max-width:1240px; margin:0 auto; padding:6px 40px 14px; font-family:'Source Sans 3', Arial, sans-serif;"
    >
      {navLinks.map((link) => (
        <a
          href={link.href}
          style={`display:flex; align-items:center; min-height:48px; border-bottom:1px solid rgba(255,255,255,0.08); color:${link.label === active ? "#fff" : "rgba(255,255,255,0.7)"}; font-size:15px; font-weight:${link.label === active ? "600" : "400"};`}
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
  {tickerItems.length > 0 && (
    <div class="ticker-viewport" style="background:#c81324; overflow:hidden;">
      <div class="ticker-track" style="display:flex; width:max-content;">
        {[0, 1].map((pass) => (
          <div class="ticker-row" style="display:flex; gap:36px; padding:9px 40px 9px 0; flex:0 0 auto;" aria-hidden={pass === 1 ? "true" : undefined}>
            {tickerItems.map((item) => (
              <a translate="no" href={item.href} style="color:#fff; text-decoration:none; font-family:'IBM Plex Mono', monospace; font-size:13px; font-weight:600; white-space:nowrap;">
                {item.label} {item.rate} {item.direction === "up" ? "▲" : item.direction === "down" ? "▼" : ""}{item.changeLabel}
              </a>
            ))}
          </div>
        ))}
      </div>
    </div>
  )}
</div>

<style>
  @keyframes ticker-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  .ticker-track {
    animation: ticker-scroll 90s linear infinite;
  }
  .ticker-viewport:hover .ticker-track {
    animation-play-state: paused;
  }
</style>

<style is:global>
  /* Google's Website Translator widget injects its own top banner iframe,
     a hover tooltip, and a highlight/box-shadow on the translated text —
     none of it fits this design, and the banner iframe shoves the whole
     page down when it appears. Our own header dropdown is the only UI for
     switching language, so suppress all of Google's chrome and the layout
     shift it causes. */
  .goog-te-banner-frame, .goog-te-balloon-frame, #goog-gt-tt {
    display: none !important;
  }
  body {
    top: 0px !important;
  }
  .goog-text-highlight {
    background: none !important;
    box-shadow: none !important;
  }

  /* Google wraps every translated string in <font> tags carrying their own
     styling (including vertical-align), which knocks text off the baseline
     inside the flex rows this layout is built from. Make them behave like the
     plain text nodes they replaced. */
  font {
    font: inherit !important;
    vertical-align: baseline !important;
  }

  /* None of the design's fonts carry CJK glyphs, so Chinese and Japanese
     would otherwise fall back to whatever the OS picks and clash with the
     rest of the page. Scoped to the <font> wrappers so only the translated
     text switches — untranslated bits (rates, currency codes) keep the
     design font. Japanese gets its own face rather than borrowing the
     Simplified-Chinese one: the two draw many shared kanji differently. */
  html[lang^="zh"] font {
    font-family: "Noto Sans SC", "Manrope", sans-serif !important;
  }
  html[lang^="ja"] font {
    font-family: "Noto Sans JP", "Manrope", sans-serif !important;
  }
</style>

<script>
  const dateEl = document.getElementById("local-date");
  const clockEl = document.getElementById("local-clock");
  const now = new Date();
  if (dateEl) dateEl.textContent = now.toLocaleDateString(undefined, { weekday: "long", year: "numeric", month: "long", day: "numeric" });
  if (clockEl) clockEl.textContent = "Updated at " + now.toLocaleTimeString(undefined, { hour: "2-digit", minute: "2-digit" });

  // The drawer holds whichever destinations the bar dropped at this width.
  // CSS decides whether the toggle exists at all, so no width check here.
  const navToggle = document.getElementById("nav-toggle");
  const navDrawer = document.getElementById("nav-drawer");
  if (navToggle && navDrawer) {
    navToggle.addEventListener("click", () => {
      const open = navDrawer.dataset.open !== "true";
      navDrawer.dataset.open = open ? "true" : "false";
      navToggle.setAttribute("aria-expanded", open ? "true" : "false");
      navToggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    });
  }

  const langToggle = document.querySelector(".translate-toggle");
  const langMenu = document.querySelector(".translate-menu") as HTMLElement | null;
  if (langToggle && langMenu) {
    langToggle.addEventListener("click", (e) => {
      e.stopPropagation();
      langMenu.style.display = langMenu.style.display === "none" || !langMenu.style.display ? "block" : "none";
    });
    document.addEventListener("click", () => { langMenu.style.display = "none"; });
  }

  // Google's Website Translator translates the DOM in place — no page
  // navigation — once you drive the hidden <select class="goog-te-combo">
  // it creates inside #google_translate_element. Setting `.value` and
  // dispatching "change" is the standard trick; there is no public JS API.
  function findCombo(): HTMLSelectElement | null {
    return document.querySelector("#google_translate_element select.goog-te-combo");
  }

  // Google remembers the active translation in a googtrans cookie, so it has
  // to go when returning to English — otherwise the next load comes back
  // translated despite the visitor asking for the original.
  function clearTranslateCookie() {
    const expire = "=;expires=Thu, 01 Jan 1970 00:00:01 GMT;path=/";
    document.cookie = "googtrans" + expire;
    document.cookie = "googtrans" + expire + ";domain=" + location.hostname;
    document.cookie = "googtrans" + expire + ";domain=." + location.hostname;
  }

  function applyLanguage(code: string) {
    const combo = findCombo();
    if (!combo) return false;
    combo.value = code;
    // A <select> silently ignores a value it has no <option> for, so confirm
    // the assignment stuck before reporting success — otherwise the caller
    // stops retrying on a switch that never actually happened.
    if (combo.value !== code) return false;
    combo.dispatchEvent(new Event("change"));
    return true;
  }

  // Restoring the original is not just "translate to en": depending on the
  // widget version Google either offers the source language in the combo or
  // drops it entirely (nothing translates English into English), and there is
  // no API to ask. So try the combo, and when it has no such option fall back
  // to dropping the cookie and reloading — the page is authored in English,
  // so it comes back untranslated on its own. Reloading only here keeps the
  // no-reload behaviour for every actual translation.
  function restoreOriginal() {
    clearTranslateCookie();
    return applyLanguage("en");
  }

  function updateToggleUi(option: HTMLElement) {
    const flagEl = document.getElementById("translate-toggle-flag") as HTMLImageElement | null;
    if (flagEl && option.dataset.flag) flagEl.src = option.dataset.flag;
  }

  // Layout.astro only asks for the CJK faces when the visitor arrives already
  // on Chinese or Japanese, because requesting them takes the Google Fonts
  // stylesheet from 26 KB to 932 KB for everyone. Picking either by hand is
  // the other way in, so fetch them at that point. The next page load carries
  // the link itself, since the choice is in the site_lang cookie by then.
  function ensureCjkFonts(code: string) {
    if (code !== "zh-CN" && code !== "ja") return;
    if (document.getElementById("cjk-fonts")) return;
    const link = document.createElement("link");
    link.id = "cjk-fonts";
    link.rel = "stylesheet";
    link.href = "https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;600;700&display=swap";
    document.head.appendChild(link);
  }

  function commit(code: string) {
    const option = document.querySelector<HTMLElement>(`.translate-option[data-lang="${code}"]`);
    if (option) updateToggleUi(option);
    ensureCjkFonts(code);
    // Recorded as well as announced. Both this script and the listeners on the
    // home page are deferred modules, and this one runs first — so when the
    // widget happens to be ready on the first pump (a warm cache), commit()
    // fires before those listeners exist and the event alone would be lost.
    // A listener that also reads this on startup cannot miss the language.
    document.documentElement.dataset.siteLang = code;
    document.dispatchEvent(new CustomEvent("sitelang:change", { detail: { lang: code } }));
  }

  // Google's script is loaded async, so the combo often does not exist yet
  // when the page (or an impatient visitor) asks for a language. Both the IP
  // guess and a click therefore only record *what is wanted*; one pump drives
  // it, retrying until the widget exists. Because a click overwrites the
  // wanted language, a late IP guess can no longer undo the visitor's choice,
  // and a click made before the widget was ready is no longer dropped.
  const toggleBtn = document.getElementById("translate-toggle");
  const autoLang = toggleBtn?.dataset.autoLang;
  let desiredLang: string | null = autoLang && autoLang !== "en" ? autoLang : null;
  let attempts = 0;
  let pumpTimer: number | undefined;

  function pump() {
    pumpTimer = undefined;
    if (!desiredLang) return;
    const wanted = desiredLang;
    if (applyLanguage(wanted)) {
      desiredLang = null;
      commit(wanted);
      return;
    }
    if (++attempts < 25) pumpTimer = window.setTimeout(pump, 200);
  }

  document.querySelectorAll<HTMLElement>(".translate-option").forEach((option) => {
    option.addEventListener("click", () => {
      const code = option.dataset.lang;
      if (!code) return;

      // Remember the choice first: the server renders this language's country
      // on later loads (the IP guess only decides the first visit), and the
      // English fallback below reloads, which needs the cookie already set.
      document.cookie = "site_lang=" + code + ";path=/;max-age=31536000;samesite=lax";
      if (pumpTimer) clearTimeout(pumpTimer);

      // Start the font download now rather than in commit(), which only runs
      // once Google's widget is ready — this way the face and the translation
      // arrive together instead of one after the other.
      ensureCjkFonts(code);

      if (code === "en") {
        desiredLang = null;
        if (!restoreOriginal()) {
          location.reload();
          return;
        }
        commit("en");
        return;
      }

      desiredLang = code;
      attempts = 0;
      pump();
    });
  });

  pump();

</script>

<!-- The callback has to exist before Google's async script runs, so it is
     defined in a plain inline script rather than the module above (which
     Astro defers, and which would therefore lose the race). -->
<script is:inline>
  window.googleTranslateElementInit = function googleTranslateElementInit() {
    new window.google.translate.TranslateElement(
      { pageLanguage: "en", includedLanguages: "en,vi,zh-CN,ja,es,fr", autoDisplay: false },
      "google_translate_element",
    );
  };
</script>
<script is:inline src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit" async></script>
