---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";
import { buildHomeModel, buildQuoteRateRows } from "../lib/home";
import { buildMenuModel } from "../lib/menu";
import { CURRENCY_PROFILES, MAJOR_COLUMNS, configCurrencies } from "../lib/config";
import { formatRate, currencySymbol } from "../lib/format";
import { flagSrc, SWAP_ICON, CHEVRON_DOWN, ARROW_UP } from "../lib/flags";
import {
  resolveVisitorLocale, currencyForCountry, countryForLanguage, SUPPORTED_LANGUAGES,
} from "../lib/geo";

// The converter and the rate board each drive a currency picker, and both need
// the same three lookup tables. They used to arrive through `define:vars` on
// each script, which has two costs: `define:vars` forces the script inline, so
// the browser re-downloads ~25 KB of unchanging logic on every navigation (the
// HTML is deliberately `no-cache` — see src/middleware.ts), and the tables are
// serialised twice into the same document.
//
// Emitting them once as a JSON island lets both scripts become ordinary
// bundled scripts: Astro hashes them into /_astro/, where they are cached
// `immutable` and fetched once for the whole visit.
//
// Only `name` is carried over from CURRENCY_PROFILES. The `region`, `role` and
// `use` fields are prose for the server-rendered copy and no client script
// reads them, but they were the bulk of what went over the wire.
const currencyMeta = JSON.stringify({
  names: Object.fromEntries(configCurrencies().map((c) => [c, CURRENCY_PROFILES[c]?.name ?? c])),
  flags: Object.fromEntries(configCurrencies().map((c) => [c, flagSrc(c)])),
  langCurrency: Object.fromEntries(
    SUPPORTED_LANGUAGES.map((lang) => [lang, currencyForCountry(countryForLanguage(lang)) ?? "USD"]),
  ),
});

// Everything country-specific on this page — the rate board, the converter
// and the hero chart — follows the visitor's country. The IP header decides
// the first render; a language the visitor picks by hand outranks it from
// then on, and the picker writes that choice to a cookie so the server keeps
// rendering the matching country after a reload (otherwise the page would
// come back translated but showing another country's data).
// Switching the board through ?quote= stays disabled: the picker options
// below are inert and the board follows the country instead.
const locale = resolveVisitorLocale(Astro.request, Astro.cookies.get("site_lang")?.value);
const converterFrom = locale.currency;
const converterTarget = converterFrom === "USD" ? "EUR" : "USD";
const autoLang = locale.lang;
const quote = converterFrom;

// Independent reads of the same cached rate set — started together so the
// page waits for the slower of the two rather than for their sum.
const [model, rateRows] = await Promise.all([
  buildHomeModel(quote, false, [converterFrom, converterTarget]),
  buildQuoteRateRows(quote),
]);
const menu = buildMenuModel();
const VISIBLE_RATE_ROWS = 8;

const converterRate = model.latestUsdTable[converterTarget] && model.latestUsdTable[converterFrom]
  ? model.latestUsdTable[converterTarget] / model.latestUsdTable[converterFrom]
  : null;

const popularCurrencies = MAJOR_COLUMNS;
const otherCurrencies = configCurrencies().filter((c) => !popularCurrencies.includes(c));

const description = "Compare popular currencies against USD, EUR, JPY, GBP, CNY, and VND with live conversion tables and normalized exchange-rate charts.";
---

<Layout title="Exchange Rates Dashboard" description={description} path="/">
  <div>
    <Header pairMovers={model.pairMovers} active="ExchangeHub" autoLang={autoLang} />

    <div style="background:radial-gradient(1100px 560px at 82% -10%, rgba(225,29,63,0.28), transparent 60%), #0c0b0d;">
      <div class="page-pad home-hero" style="max-width:1280px; margin:0 auto; padding:64px 40px 72px; display:grid; grid-template-columns:1.05fr 0.95fr; gap:56px; align-items:center;">
        <div style="display:flex; flex-direction:column; gap:24px; align-items:flex-start; font-family:'Manrope', Arial, sans-serif;">
          <span style="display:inline-flex; align-items:center; gap:8px; background:rgba(225,29,63,0.14); border:1px solid rgba(225,29,63,0.4); color:#ff4d6d; font-size:13px; font-weight:600; padding:7px 14px; border-radius:999px;">
            <svg width="8" height="8" viewBox="0 0 8 8"><circle cx="4" cy="4" r="4" fill="#ff4d6d" /></svg>
            Live &middot; updated every 5 minutes
          </span>
          <h1 style="font-family:'Space Grotesk', Arial, sans-serif; font-size:52px; line-height:1.1; font-weight:700; letter-spacing:-0.02em; color:#f5f2f1; margin:0;">Exchange rates,<br />right now.</h1>
          <p style="font-size:17px; line-height:1.65; color:#a79fa0; max-width:500px; margin:0;">
            Track {configCurrencies().length} currencies with live charts and full historical data — all in one dashboard.
            {model.updated && <> Updated {model.updated}.</>}
          </p>
          <div class="home-cta" style="display:flex; gap:14px; flex-wrap:wrap;">
            <a href="#today-rates" style="display:inline-flex; align-items:center; gap:8px; height:50px; padding:0 26px; border-radius:999px; font-weight:600; font-size:15px; cursor:pointer; background:#e11d3f; color:#fff; border:none; box-shadow:0 0 0 1px rgba(225,29,63,0.5), 0 12px 30px rgba(225,29,63,0.35);">
              Open rate board
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
            <a href="#converter" style="height:50px; padding:0 26px; border-radius:999px; font-weight:600; font-size:15px; cursor:pointer; background:transparent; color:#fff; border:1.5px solid #2a2426; display:inline-flex; align-items:center;">Convert currency</a>
          </div>
        </div>

        {model.hero && (
          <div class="hero-card" style="background:rgba(255,255,255,0.04); backdrop-filter:blur(6px); border:1px solid #2a2426; border-radius:20px; padding:28px; font-family:'Manrope', Arial, sans-serif;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <span translate="no" style="font-size:13px; font-weight:600; color:#a79fa0; display:inline-flex; align-items:center;">
                <span id="hero-pair-base">{model.hero.label.split("/")[0]}</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" style="display:inline-block; vertical-align:-2px; margin:0 3px;" set:html={SWAP_ICON} />
                <span id="hero-pair-target">{model.hero.label.split("/")[1]}</span>
              </span>
              <span translate="no" style="font-size:11px; color:#a79fa0; background:rgba(255,255,255,0.06); padding:4px 9px; border-radius:999px;">24H</span>
            </div>
            <div style="display:flex; align-items:baseline; gap:10px; margin-top:14px;">
              <span id="hero-rate" class="hero-rate" translate="no" style="font-family:'Space Grotesk', Arial, sans-serif; font-size:44px; font-weight:700; color:#f5f2f1;">{model.hero.rate}</span>
              <span id="hero-change" translate="no" style={`display:inline-flex; align-items:center; gap:4px; color:${model.hero.direction === "up" ? "#34d399" : model.hero.direction === "down" ? "#ff4d6d" : "#a79fa0"}; font-size:14px; font-weight:600; background:${model.hero.direction === "up" ? "rgba(52,211,153,0.14)" : model.hero.direction === "down" ? "rgba(225,29,63,0.14)" : "rgba(255,255,255,.06)"}; padding:4px 9px; border-radius:999px;`}>
                <svg
                  id="hero-change-arrow"
                  width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
                  style={`${model.hero.direction === "down" ? "transform:rotate(180deg);" : ""}${model.hero.direction === "flat" ? "display:none;" : ""}`}
                  set:html={ARROW_UP}
                />
                <span id="hero-change-text">{model.hero.changeLabel}</span>
              </span>
            </div>
            {model.hero.points && (
              <div style="position:relative; margin-top:20px;">
                <svg width="100%" height="88" viewBox="0 0 400 88" style="display:block;" preserveAspectRatio="none">
                  <defs>
                    <linearGradient id="heroFill" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0" stop-color="#e11d3f" stop-opacity="0.35" />
                      <stop offset="1" stop-color="#e11d3f" stop-opacity="0" />
                    </linearGradient>
                  </defs>
                  <polygon id="hero-area" points={`0,88 ${model.hero.points} 400,88`} fill="url(#heroFill)" />
                  <polyline id="hero-line" points={model.hero.points} fill="none" stroke="#ff4d6d" stroke-width="2.5" />
                </svg>
                <span
                  id="hero-dot"
                  style={`position:absolute; right:0; top:${model.hero.dotY}%; transform:translate(50%,-50%); width:9px; height:9px; border-radius:50%; background:#34d399; box-shadow:0 0 0 3px rgba(52,211,153,0.25), 0 0 12px 3px rgba(52,211,153,0.65);`}
                ></span>
              </div>
            )}
            <div
              id="hero-tiles"
              style={`display:${model.hero.secondary.length > 0 ? "grid" : "none"}; grid-template-columns:repeat(${model.hero.secondary.length || 3},1fr); gap:10px; margin-top:22px;`}
            >
              {model.hero.secondary.map((item) => (
                <a href={item.href} class="rate-card">
                  <div translate="no" class="rate-card-label">{item.label}</div>
                  <div translate="no" class="rate-card-value">{item.rate}</div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>

      <div id="converter" class="page-pad" style="max-width:1280px; margin:0 auto; padding:0 40px 56px; font-family:'Manrope', Arial, sans-serif;">
        <div id="conv-card" class="conv-card" data-rates={JSON.stringify(model.latestUsdTable)} style="background:#ffffff; border-radius:20px; padding:32px; box-shadow:0 24px 60px rgba(0,0,0,0.35); position:relative;">
          <div class="conv-grid" style="display:grid; grid-template-columns:1fr 1fr;">
            <div class="conv-side conv-side-from" style="padding-right:28px;">
              <div style="font-size:13px; color:#6b6560; font-weight:600; margin-bottom:10px;">From</div>
              <div style="display:flex; align-items:center; justify-content:space-between; gap:12px;">
                <div class="conv-amount-wrap" style="display:flex; align-items:baseline; font-size:32px; font-weight:800; color:#14100f;">
                  <span id="conv-amount-symbol" translate="no">{currencySymbol(converterFrom)}</span>
                  <input id="conv-amount" type="text" inputmode="decimal" translate="no" value="1.00" style="font-size:32px; font-weight:800; color:#14100f; border:none; outline:none; width:110px; padding:0;" />
                </div>
                <div style="position:relative;">
                  <button type="button" id="conv-from-btn" data-code={converterFrom} style="display:inline-flex; align-items:center; gap:8px; background:transparent; border:none; cursor:pointer; padding:0;">
                    <img class="conv-flag flag-ico" src={flagSrc(converterFrom)} alt="" width="24" height="24" />
                    <span class="conv-code" translate="no" style="font-weight:700; color:#14100f; font-size:15px;">{converterFrom}</span>
                    <span class="conv-name" style="color:#6b6560; font-size:14px;">{CURRENCY_PROFILES[converterFrom]?.name}</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6b6560" stroke-width="2.4" set:html={CHEVRON_DOWN} />
                  </button>
                  <div id="conv-from-panel" class="conv-panel picker-scroll" style="display:none; position:absolute; right:0; top:calc(100% + 8px); z-index:30; width:220px; max-height:260px; overflow-y:auto; background:#fff; border:1px solid #e6e1de; border-radius:10px; box-shadow:0 16px 40px rgba(15,23,42,.14); padding:6px;">
                    {configCurrencies().map((code) => (
                      <button type="button" class="conv-option picker-row" data-code={code}>
                        <img src={flagSrc(code)} alt="" width="20" height="20" class="flag-ico" loading="lazy" decoding="async" /> <span translate="no">{code}</span> {CURRENCY_PROFILES[code]?.name}
                      </button>
                    ))}
                  </div>
                </div>
              </div>
            </div>
            <div class="conv-side conv-side-to" style="padding-left:28px; border-left:1px solid #e6e1de;">
              <div style="font-size:13px; color:#6b6560; font-weight:600; margin-bottom:10px;">To</div>
              <div style="display:flex; align-items:center; justify-content:space-between; gap:12px;">
                <span class="conv-result" style="font-size:32px; font-weight:800; color:#14100f;"><span id="conv-result-symbol" translate="no">{currencySymbol(converterTarget)}</span><span id="conv-result" translate="no">{converterRate ? formatRate(converterRate) : "—"}</span></span>
                <div style="position:relative;">
                  <button type="button" id="conv-to-btn" data-code={converterTarget} style="display:inline-flex; align-items:center; gap:8px; background:transparent; border:none; cursor:pointer; padding:0;">
                    <img class="conv-flag flag-ico" src={flagSrc(converterTarget)} alt="" width="24" height="24" />
                    <span class="conv-code" translate="no" style="font-weight:700; color:#14100f; font-size:15px;">{converterTarget}</span>
                    <span class="conv-name" style="color:#6b6560; font-size:14px;">{CURRENCY_PROFILES[converterTarget]?.name}</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6b6560" stroke-width="2.4" set:html={CHEVRON_DOWN} />
                  </button>
                  <div id="conv-to-panel" class="conv-panel picker-scroll" style="display:none; position:absolute; right:0; top:calc(100% + 8px); z-index:30; width:220px; max-height:260px; overflow-y:auto; background:#fff; border:1px solid #e6e1de; border-radius:10px; box-shadow:0 16px 40px rgba(15,23,42,.14); padding:6px;">
                    {configCurrencies().map((code) => (
                      <button type="button" class="conv-option picker-row" data-code={code}>
                        <img src={flagSrc(code)} alt="" width="20" height="20" class="flag-ico" loading="lazy" decoding="async" /> <span translate="no">{code}</span> {CURRENCY_PROFILES[code]?.name}
                      </button>
                    ))}
                  </div>
                </div>
              </div>
            </div>
            {/* A grid child rather than a sibling of the grid: it stays
                absolutely positioned (against the card, which is the nearest
                positioned ancestor) on desktop, and on mobile it drops into
                the flow between the two stacked sides via `order`. */}
            <button type="button" id="conv-swap" class="conv-swap" style="position:absolute; left:50%; top:78px; transform:translate(-50%,-50%); width:36px; height:36px; border-radius:50%; background:#fff; border:1px solid #e6e1de; box-shadow:0 4px 10px rgba(0,0,0,0.12); display:flex; align-items:center; justify-content:center; cursor:pointer;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#14100f" stroke-width="2.2" set:html={SWAP_ICON} />
            </button>
          </div>
          <div class="conv-footer" style="display:flex; align-items:center; justify-content:space-between; gap:16px; margin-top:24px; padding-top:24px; border-top:1px solid #f0ece9; flex-wrap:wrap;">
            <div>
              <div id="conv-summary" translate="no" style="font-size:17px; font-weight:700; color:#14100f;">1.00 {converterFrom} = {converterRate ? formatRate(converterRate) : "—"} {converterTarget}</div>
              <div style="font-size:13px; color:#8b857f; margin-top:2px;">Mid-market rate {model.updated && <>as of {model.updated}</>}</div>
            </div>
            <a id="conv-full-link" href={`/${converterFrom.toLowerCase()}-${converterTarget.toLowerCase()}`} style="height:48px; padding:0 26px; border-radius:999px; background:#e11d3f; color:#fff; border:none; font-weight:700; font-size:15px; cursor:pointer; display:inline-flex; align-items:center;">Full converter</a>
          </div>
          <div style="display:flex; align-items:flex-start; gap:8px; margin-top:16px; font-size:12.5px; color:#8b857f; line-height:1.5;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#8b857f" stroke-width="2" style="flex:0 0 auto; margin-top:2px;"><circle cx="12" cy="12" r="9" /><path d="M12 8h.01M11 12h1v5h1" /></svg>
            <span>We use the mid-market rate for this converter. It is for informational purposes only.</span>
          </div>
        </div>
        <!-- Read by both this page's scripts; see currencyMeta above. -->
        <script type="application/json" id="currency-meta" is:inline set:html={currencyMeta} />
        <script>
          (function () {
            const card = document.getElementById("conv-card");
            const metaEl = document.getElementById("currency-meta");
            if (!card || !metaEl) return;
            const meta = JSON.parse(metaEl.textContent || "{}") as {
              names: Record<string, string>;
              flags: Record<string, string | null>;
              langCurrency: Record<string, string>;
            };
            const names = meta.names, flags = meta.flags, langCurrency = meta.langCurrency;
            const rates = JSON.parse(card.dataset.rates || "{}") as Record<string, number>;
            const amountInput = document.getElementById("conv-amount") as HTMLInputElement | null;
            const resultEl = document.getElementById("conv-result");
            const amountSymbolEl = document.getElementById("conv-amount-symbol");
            const resultSymbolEl = document.getElementById("conv-result-symbol");
            const summaryEl = document.getElementById("conv-summary");
            const fullLink = document.getElementById("conv-full-link") as HTMLAnchorElement | null;
            const fromBtn = document.getElementById("conv-from-btn");
            const toBtn = document.getElementById("conv-to-btn");
            const fromPanel = document.getElementById("conv-from-panel");
            const toPanel = document.getElementById("conv-to-panel");
            // Everything below drives one widget: without any of these parts
            // there is nothing to wire up, and checking once here keeps the
            // handlers free of repeated null guards.
            if (!amountInput || !resultEl || !summaryEl || !fromBtn || !toBtn || !fromPanel || !toPanel) return;

            function rateFor(base: string, target: string) {
              const b = rates[base];
              const t = rates[target];
              if (!b || !t) return null;
              return t / b;
            }

            function formatRate(value: number) {
              const num = Number(value);
              const abs = Math.abs(num);
              if (num === 0) return "0";
              if (abs < 1) return String(num.toFixed(8)).replace(/0+$/, "").replace(/\.$/, "");
              if (abs < 1000) return String(num.toFixed(6)).replace(/0+$/, "").replace(/\.$/, "");
              return num.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            function setButtonCode(btn: HTMLElement, code: string) {
              btn.dataset.code = code;
              const flagImg = btn.querySelector<HTMLImageElement>(".conv-flag");
              const codeSpan = btn.querySelector(".conv-code");
              const nameSpan = btn.querySelector(".conv-name");
              const flagSrc = flags[code];
              if (flagImg && flagSrc) flagImg.src = flagSrc;
              if (codeSpan) codeSpan.textContent = code;
              if (nameSpan) nameSpan.textContent = names[code] || "";
            }

            const symbolCache: Record<string, string> = {};
            function symbolFor(code: string) {
              if (symbolCache[code] !== undefined) return symbolCache[code];
              let symbol = code;
              try {
                const part = new Intl.NumberFormat("en-US", { style: "currency", currency: code, currencyDisplay: "narrowSymbol" })
                  .formatToParts(0)
                  .find((p) => p.type === "currency");
                if (part) symbol = part.value;
              } catch (e) {
                // unsupported currency code — fall back to the code itself
              }
              symbolCache[code] = symbol;
              return symbol;
            }

            // Arrow functions rather than declarations: a hoisted `function`
            // is typed as if it could run before the guard above, so none of
            // the elements it closes over count as non-null inside it.
            const recompute = () => {
              const from = fromBtn.dataset.code || "";
              const to = toBtn.dataset.code || "";
              const amount = parseFloat(amountInput.value) || 0;
              const rate = rateFor(from, to);
              if (rate === null) {
                resultEl.textContent = "—";
                summaryEl.textContent = `1.00 ${from} = — ${to}`;
              } else {
                resultEl.textContent = formatRate(amount * rate);
                summaryEl.textContent = `1.00 ${from} = ${formatRate(rate)} ${to}`;
              }
              if (amountSymbolEl) amountSymbolEl.textContent = symbolFor(from);
              if (resultSymbolEl) resultSymbolEl.textContent = symbolFor(to);
              if (fullLink) fullLink.href = `/${from.toLowerCase()}-${to.toLowerCase()}`;
            };

            const wirePanel = (btn: HTMLElement, panel: HTMLElement, onPick: (code: string) => void) => {
              btn.addEventListener("click", (e) => {
                e.stopPropagation();
                const isOpen = panel.style.display === "block";
                fromPanel.style.display = "none";
                toPanel.style.display = "none";
                panel.style.display = isOpen ? "none" : "block";
              });
              panel.querySelectorAll<HTMLElement>(".conv-option").forEach((opt) => {
                opt.addEventListener("click", () => {
                  onPick(opt.dataset.code || "");
                  panel.style.display = "none";
                  recompute();
                });
              });
            };

            wirePanel(fromBtn, fromPanel, (code) => setButtonCode(fromBtn, code));
            wirePanel(toBtn, toPanel, (code) => setButtonCode(toBtn, code));
            document.addEventListener("click", () => {
              fromPanel.style.display = "none";
              toPanel.style.display = "none";
            });
            amountInput.addEventListener("input", recompute);
            document.getElementById("conv-swap")?.addEventListener("click", () => {
              const fromCode = fromBtn.dataset.code || "";
              const toCode = toBtn.dataset.code || "";
              setButtonCode(fromBtn, toCode);
              setButtonCode(toBtn, fromCode);
              recompute();
            });

            // Picking a language re-points the country-specific data: the IP
            // country only decides the first render, an explicit choice wins
            // from then on (the server applies the same rule via cookie).
            function directionColors(direction: string) {
              if (direction === "up") return { bg: "rgba(52,211,153,0.14)", fg: "#34d399" };
              if (direction === "down") return { bg: "rgba(225,29,63,0.14)", fg: "#ff4d6d" };
              return { bg: "rgba(255,255,255,.06)", fg: "#a79fa0" };
            }

            // Switching language twice in quick succession leaves two requests
            // in flight, and the slower one can land last — painting the chart
            // for a currency the rest of the page has already moved on from.
            // Only the newest request may touch the DOM.
            let heroRequest = 0;

            function updateHero(base: string, target: string) {
              const line = document.getElementById("hero-line");
              const pairBase = document.getElementById("hero-pair-base");
              const pairTarget = document.getElementById("hero-pair-target");
              const rateEl = document.getElementById("hero-rate");
              const changeText = document.getElementById("hero-change-text");
              const badge = document.getElementById("hero-change");
              const arrow = document.getElementById("hero-change-arrow");
              const area = document.getElementById("hero-area");
              const dot = document.getElementById("hero-dot");
              // The hero is one block of markup: either the whole set is on the
              // page or none of it is, so one guard stands in for nine.
              if (!line || !pairBase || !pairTarget || !rateEl || !changeText
                  || !badge || !arrow || !area || !dot) return;
              const token = ++heroRequest;
              fetch(`/api/hero?base=${encodeURIComponent(base)}&target=${encodeURIComponent(target)}`)
                .then((res) => (res.ok ? res.json() : null))
                .then((data) => {
                  if (token !== heroRequest) return;
                  if (!data || !data.points) return;
                  pairBase.textContent = base;
                  pairTarget.textContent = target;
                  rateEl.textContent = data.rate;
                  changeText.textContent = data.changeLabel;
                  const c = directionColors(data.direction);
                  badge.style.background = c.bg;
                  badge.style.color = c.fg;
                  arrow.style.display = data.direction === "flat" ? "none" : "";
                  arrow.style.transform = data.direction === "down" ? "rotate(180deg)" : "";
                  line.setAttribute("points", data.points);
                  area.setAttribute("points", `0,88 ${data.points} 400,88`);
                  dot.style.top = data.dotY + "%";

                  const tiles = document.getElementById("hero-tiles");
                  const items = data.secondary || [];
                  if (tiles) {
                    tiles.style.display = items.length ? "grid" : "none";
                    tiles.style.gridTemplateColumns = `repeat(${items.length || 3},1fr)`;
                    tiles.innerHTML = items.map((item: { href: string; label: string; rate: string }) => `
                      <a href="${item.href}" class="rate-card">
                        <div translate="no" class="rate-card-label">${item.label}</div>
                        <div translate="no" class="rate-card-value">${item.rate}</div>
                      </a>`).join("");
                  }
                })
                .catch(() => {});
            }

            const applyLang = (lang: string | undefined) => {
              const from = lang ? langCurrency[lang] : undefined;
              if (!from) return;
              const to = from === "USD" ? "EUR" : "USD";
              setButtonCode(fromBtn, from);
              setButtonCode(toBtn, to);
              recompute();
              updateHero(from, to);
            };

            document.addEventListener("sitelang:change", (event) => {
              applyLang((event as CustomEvent<{ lang: string }>).detail.lang);
            });
            // The header commits the language from its own deferred module,
            // which runs before this one — so a commit that has already
            // happened left the language here rather than in an event.
            applyLang(document.documentElement.dataset.siteLang);
          })();
        </script>

        <div class="home-banner" style="margin-top:20px; border-radius:16px; padding:28px 32px; background:radial-gradient(700px 260px at 85% 0%, rgba(225,29,63,0.35), transparent 65%), #14100f; display:flex; align-items:center; justify-content:space-between; gap:24px; flex-wrap:wrap;">
          <div style="font-size:21px; font-weight:700; color:#fff; max-width:520px; line-height:1.35;">Explore any currency pair with full historical charts and context.</div>
          <a href="/chart" style="height:44px; padding:0 22px; border-radius:999px; background:#fff; color:#14100f; border:none; font-weight:700; font-size:14px; cursor:pointer; white-space:nowrap; display:inline-flex; align-items:center;">Open chart tool</a>
        </div>
      </div>

      <div id="today-rates" class="page-pad" style="max-width:1280px; margin:0 auto; padding:0 40px 96px; font-family:'Manrope', Arial, sans-serif;">
        <div style="display:flex; align-items:baseline; justify-content:space-between; margin-bottom:24px; flex-wrap:wrap; gap:8px;">
          <h2 class="home-section-title" style="font-family:'Space Grotesk', Arial, sans-serif; font-size:28px; color:#f5f2f1; margin:0;">Today's exchange rates</h2>
        </div>

        <div style="background:#151315; border:1px solid #2a2426; border-radius:16px; overflow:hidden;">
          <div id="rates-bar" class="rates-bar" style="display:flex; align-items:center; justify-content:space-between; padding:16px 22px; background:#0c0b0d; border-bottom:1px solid #2a2426;">
            <div style="display:flex; align-items:center; gap:10px;">
              <img id="rates-bar-flag" src={flagSrc(quote)} alt="" width="24" height="24" style="display:block;" />
              <span id="rates-bar-label" translate="no" style="color:#f5f2f1; font-weight:700; font-size:15px;">{CURRENCY_PROFILES[quote]?.name ?? quote} ({quote})</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#a79fa0" stroke-width="2.4" set:html={CHEVRON_DOWN} />
            </div>
            <span style="color:#a79fa0; font-size:14px;">1</span>
          </div>

          <div class="rates-split" style="display:flex; align-items:stretch;">
            <div id="rates-picker" class="picker-scroll rates-picker" data-open="false" style="width:240px; flex:0 0 240px; border-right:1px solid #2a2426; padding:16px; display:flex; flex-direction:column; gap:14px; max-height:520px; overflow-y:auto; overflow-x:hidden;">
              <div style="display:flex; align-items:center; gap:8px; background:#1c191b; border:1px solid #2a2426; border-radius:8px; padding:9px 12px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#a79fa0" stroke-width="2"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" /></svg>
                <input
                  id="quote-picker-search"
                  type="text"
                  placeholder="Search currencies..."
                  autocomplete="off"
                  style="flex:1; min-width:0; background:transparent; border:none; outline:none; color:#f5f2f1; font-size:13px; font-family:inherit;"
                />
              </div>
              <div id="quote-picker-popular" data-group>
                <div class="picker-group-label" style="color:#746b66; font-size:11px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; margin-bottom:8px;">Popular</div>
                <div style="display:flex; flex-direction:column; gap:2px;">
                  {popularCurrencies.map((code) => (
                    <div
                      data-picker-option
                      data-code={code}
                      data-search={`${code} ${CURRENCY_PROFILES[code]?.name ?? ""}`.toLowerCase()}
                      style={`display:flex; align-items:center; gap:9px; padding:7px 8px; border-radius:8px; background:${code === quote ? "#1c191b" : "transparent"}; cursor:pointer;`}
                    >
                      <img src={flagSrc(code)} alt="" width="20" height="20" class="flag-ico" loading="lazy" decoding="async" />
                      <span class="picker-option-label" style={`color:${code === quote ? "#f5f2f1" : "#a79fa0"}; font-size:13px; flex:1;`}><span translate="no">{code}</span> {CURRENCY_PROFILES[code]?.name}</span>
                      {code === quote && <svg class="picker-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#ff4d6d" stroke-width="2.6"><path d="M5 13l4 4L19 7" /></svg>}
                    </div>
                  ))}
                </div>
              </div>
              <div id="quote-picker-all" data-group>
                <div class="picker-group-label" style="color:#746b66; font-size:11px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; margin-bottom:8px;">All currencies</div>
                <div style="display:flex; flex-direction:column; gap:2px;">
                  {otherCurrencies.map((code) => (
                    <div
                      data-picker-option
                      data-code={code}
                      data-search={`${code} ${CURRENCY_PROFILES[code]?.name ?? ""}`.toLowerCase()}
                      style={`display:flex; align-items:center; gap:9px; padding:7px 8px; border-radius:8px; background:${code === quote ? "#1c191b" : "transparent"}; cursor:pointer;`}
                    >
                      <img src={flagSrc(code)} alt="" width="20" height="20" class="flag-ico" loading="lazy" decoding="async" />
                      <span class="picker-option-label" style={`color:${code === quote ? "#f5f2f1" : "#a79fa0"}; font-size:13px;`}><span translate="no">{code}</span> {CURRENCY_PROFILES[code]?.name}</span>
                    </div>
                  ))}
                </div>
              </div>
              <div id="quote-picker-empty" hidden style="color:#746b66; font-size:13px; padding:7px 8px;">No currencies match your search.</div>
            </div>

            <div id="rates-rows" style="flex:1; display:flex; flex-direction:column;">
              <div id="rates-rows-list">
                {rateRows.map((row, i) => (
                  <div
                    data-rate-row
                    class="rate-row"
                    style={`display:${i >= VISIBLE_RATE_ROWS ? "none" : "flex"}; align-items:center; padding:20px 24px; ${i < rateRows.length - 1 ? "border-bottom:1px solid #2a2426;" : ""} ${i % 2 === 1 ? "background:#1c191b;" : ""}`}>
                    <span class="rr-code" translate="no" style="flex:0 0 68px; color:#f5f2f1; font-weight:700; font-size:16px;">{row.target}</span>
                    <span class="rr-rate" translate="no" style="flex:0 0 132px; text-align:right; font-variant-numeric:tabular-nums; color:#f5f2f1; font-weight:700; font-size:16px;">{row.rate}</span>
                    <span class="rr-change" translate="no" style={`flex:0 0 auto; min-width:86px; margin-left:16px; text-align:center; white-space:nowrap; font-variant-numeric:tabular-nums; background:${row.direction === "up" ? "rgba(52,211,153,0.14)" : row.direction === "down" ? "rgba(225,29,63,0.14)" : "rgba(255,255,255,.06)"}; color:${row.direction === "up" ? "#34d399" : row.direction === "down" ? "#ff4d6d" : "#a79fa0"}; font-size:13px; font-weight:600; padding:5px 11px; border-radius:999px;`}>
                      {row.changeLabel}
                    </span>
                    {row.points && (
                      <svg class="rr-spark" width="120" height="30" viewBox="0 0 120 30" style="margin-left:28px; flex:0 0 auto;" preserveAspectRatio="none">
                        <polyline points={row.points} fill="none" stroke={row.direction === "down" ? "#ff4d6d" : "#34d399"} stroke-width="2" />
                      </svg>
                    )}
                    <span class="rr-gap" style="flex:1 1 auto; min-width:16px;"></span>
                    <a class="rr-view" href={row.href} style="display:inline-flex; flex:0 0 auto; align-items:center; gap:7px; height:36px; padding:0 18px; border-radius:999px; background:#e11d3f; color:#fff; border:none; font-weight:600; font-size:13px; cursor:pointer; white-space:nowrap;">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                      View
                    </a>
                  </div>
                ))}
              </div>
              <div id="rates-empty" style={`padding:24px; color:#a79fa0; display:${rateRows.length === 0 ? "block" : "none"};`}>No stored rates yet for {quote}.</div>
              <button
                type="button"
                id="rates-load-more"
                data-step={VISIBLE_RATE_ROWS}
                style={`display:${rateRows.length > VISIBLE_RATE_ROWS ? "block" : "none"}; width:100%; border-top:1px solid #2a2426; background:none; color:#ff4d6d; font-weight:600; font-size:13px; padding:14px; cursor:pointer; text-align:center;`}
              >
                Load more
              </button>
            </div>
          </div>
        </div>

        <script>
          (function () {
            const metaEl = document.getElementById("currency-meta");
            if (!metaEl) return;
            const meta = JSON.parse(metaEl.textContent || "{}") as {
              names: Record<string, string>;
              flags: Record<string, string | null>;
              langCurrency: Record<string, string>;
            };
            const names = meta.names, flags = meta.flags, langCurrency = meta.langCurrency;
            const searchInput = document.getElementById("quote-picker-search") as HTMLInputElement | null;
            const empty = document.getElementById("quote-picker-empty");
            const groups = Array.from(document.querySelectorAll<HTMLElement>("#today-rates [data-group]"));
            if (searchInput) {
              searchInput.addEventListener("input", () => {
                const query = searchInput.value.trim().toLowerCase();
                let anyVisible = false;
                for (const group of groups) {
                  let groupHasMatch = false;
                  for (const option of group.querySelectorAll<HTMLElement>("[data-picker-option]")) {
                    const match = !query || (option.dataset.search || "").includes(query);
                    // Plain `.hidden` loses to this element's own inline
                    // `style="display:flex"` (inline style always outranks
                    // the UA's `[hidden]{display:none}` rule), so drive the
                    // display value directly instead.
                    option.style.display = match ? "flex" : "none";
                    if (match) groupHasMatch = true;
                  }
                  const label = group.querySelector<HTMLElement>(".picker-group-label");
                  if (label) label.hidden = !groupHasMatch;
                  if (groupHasMatch) anyVisible = true;
                }
                if (empty) empty.hidden = anyVisible;
              });
            }

            const rowsList = document.getElementById("rates-rows-list");
            if (!rowsList) return;
            const ratesEmpty = document.getElementById("rates-empty");
            const loadMore = document.getElementById("rates-load-more");
            const barFlag = document.getElementById("rates-bar-flag") as HTMLImageElement | null;
            const barLabel = document.getElementById("rates-bar-label");
            const step = Number((loadMore && loadMore.dataset.step) || "8");
            let shown = step;

            function directionColors(direction: string) {
              if (direction === "up") return { bg: "rgba(52,211,153,0.14)", fg: "#34d399" };
              if (direction === "down") return { bg: "rgba(225,29,63,0.14)", fg: "#ff4d6d" };
              return { bg: "rgba(255,255,255,.06)", fg: "#a79fa0" };
            }

            type RateRow = {
              target: string; rate: string; changeLabel: string;
              direction: string; points?: string; href: string;
            };

            const renderRows = (rows: RateRow[]) => {
              rowsList.innerHTML = rows.map((row, i) => {
                const c = directionColors(row.direction);
                const border = i < rows.length - 1 ? "border-bottom:1px solid #2a2426;" : "";
                const stripe = i % 2 === 1 ? "background:#1c191b;" : "";
                const display = i >= step ? "none" : "flex";
                const spark = row.points
                  ? `<svg class="rr-spark" width="120" height="30" viewBox="0 0 120 30" style="margin-left:28px; flex:0 0 auto;" preserveAspectRatio="none"><polyline points="${row.points}" fill="none" stroke="${row.direction === "down" ? "#ff4d6d" : "#34d399"}" stroke-width="2"/></svg>`
                  : "";
                // Class names here must match the server-rendered row above —
                // the responsive rules key off them, and this markup replaces
                // that one wholesale when the quote currency changes.
                return `<div data-rate-row class="rate-row" style="display:${display}; align-items:center; padding:20px 24px; ${border} ${stripe}">
                  <span class="rr-code" translate="no" style="flex:0 0 68px; color:#f5f2f1; font-weight:700; font-size:16px;">${row.target}</span>
                  <span class="rr-rate" translate="no" style="flex:0 0 132px; text-align:right; font-variant-numeric:tabular-nums; color:#f5f2f1; font-weight:700; font-size:16px;">${row.rate}</span>
                  <span class="rr-change" translate="no" style="flex:0 0 auto; min-width:86px; margin-left:16px; text-align:center; white-space:nowrap; font-variant-numeric:tabular-nums; background:${c.bg}; color:${c.fg}; font-size:13px; font-weight:600; padding:5px 11px; border-radius:999px;">${row.changeLabel}</span>
                  ${spark}
                  <span class="rr-gap" style="flex:1 1 auto; min-width:16px;"></span>
                  <a class="rr-view" href="${row.href}" style="display:inline-flex; flex:0 0 auto; align-items:center; gap:7px; height:36px; padding:0 18px; border-radius:999px; background:#e11d3f; color:#fff; border:none; font-weight:600; font-size:13px; cursor:pointer; white-space:nowrap;">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                    View
                  </a>
                </div>`;
              }).join("");
              shown = step;
              if (ratesEmpty) ratesEmpty.style.display = rows.length === 0 ? "block" : "none";
              if (loadMore) loadMore.style.display = rows.length > step ? "block" : "none";
            };

            if (loadMore) {
              loadMore.addEventListener("click", () => {
                shown += step;
                const rows = rowsList.querySelectorAll<HTMLElement>("[data-rate-row]");
                rows.forEach((row, i) => {
                  if (i < shown) row.style.display = "flex";
                });
                if (shown >= rows.length) loadMore.style.display = "none";
              });
            }

            const setActiveOption = (code: string) => {
              document.querySelectorAll<HTMLElement>("[data-picker-option]").forEach((el) => {
                const active = el.dataset.code === code;
                el.style.background = active ? "#1c191b" : "transparent";
                const label = el.querySelector<HTMLElement>(".picker-option-label");
                if (label) label.style.color = active ? "#f5f2f1" : "#a79fa0";
                const existingCheck = el.querySelector(".picker-check");
                if (existingCheck) existingCheck.remove();
                if (active && el.closest("#quote-picker-popular")) {
                  el.insertAdjacentHTML(
                    "beforeend",
                    '<svg class="picker-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#ff4d6d" stroke-width="2.6"><path d="M5 13l4 4L19 7"/></svg>',
                  );
                }
              });
            };

            // Same guard as the hero chart: a slow reply for a currency the
            // visitor has already switched away from must not repaint the
            // board over the newer one.
            let rowsRequest = 0;

            const selectQuote = (code: string) => {
              setActiveOption(code);
              const barFlagSrc = flags[code];
              if (barFlag && barFlagSrc) barFlag.src = barFlagSrc;
              if (barLabel) barLabel.textContent = `${names[code] || code} (${code})`;
              const token = ++rowsRequest;
              fetch(`/api/rates?quote=${encodeURIComponent(code)}`)
                .then((res) => res.json())
                .then((data) => {
                  if (token !== rowsRequest) return;
                  renderRows(data.rows || []);
                })
                .catch(() => {});
            };

            // On mobile the currency picker has no room beside the rows, so
            // it collapses into a panel the base-currency bar opens. The
            // media query owns whether it is collapsible at all; this only
            // records the open state, which is inert at wider widths.
            const ratesBar = document.getElementById("rates-bar");
            const ratesPicker = document.getElementById("rates-picker");
            if (ratesBar && ratesPicker) {
              ratesBar.addEventListener("click", () => {
                ratesPicker.dataset.open = ratesPicker.dataset.open === "true" ? "false" : "true";
              });
            }

            const todayRates = document.getElementById("today-rates");
            if (todayRates) {
              todayRates.addEventListener("click", (event) => {
                const target = event.target;
                const option = target instanceof Element
                  ? target.closest<HTMLElement>("[data-picker-option]")
                  : null;
                if (!option || !todayRates.contains(option)) return;
                const code = option.dataset.code;
                if (!code) return;
                selectQuote(code);
                // Picking is the panel's whole purpose — leaving it open
                // would bury the rows the visitor just asked for.
                if (ratesPicker) ratesPicker.dataset.open = "false";
              });
            }

            // The board is country data too, so a language pick re-points it
            // the same way the IP country did on first render.
            const applyLangToBoard = (lang: string | undefined) => {
              const code = lang ? langCurrency[lang] : undefined;
              if (code) selectQuote(code);
            };

            document.addEventListener("sitelang:change", (event) => {
              applyLangToBoard((event as CustomEvent<{ lang: string }>).detail.lang);
            });
            // Same reason as the converter above: the header may have committed
            // the language before this module existed to hear it.
            applyLangToBoard(document.documentElement.dataset.siteLang);
          })();
        </script>
      </div>
    </div>

    <Footer menu={menu} />
    <BackToTop />
  </div>
</Layout>
