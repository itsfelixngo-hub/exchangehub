---
export const prerender = false;

// `/analysis` — the index behind the header's Analysis tab, which used to open
// the About page.
//
// Every tracked currency gets the same card the home page's hero draws: the
// 24H line, the rate, the change pill and three cross-rate tiles. Each card
// links down to that currency's hub, so the tab answers what it promises and
// the hub level gains a second crawlable entry point beside the footer strip.
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";
import SortFilterBar from "../components/SortFilterBar.astro";
import { buildMenuModel } from "../lib/menu";
import { buildHeroChart, buildHeroSecondary, buildPairMovers } from "../lib/home";
import { MAJOR_COLUMNS, configCurrencies, currencyProfile, currencyUrl } from "../lib/config";
import { mapLimited } from "../lib/rates";
import { ARROW_UP, SWAP_ICON, flagSrc } from "../lib/flags";
import { resolveVisitorLocale } from "../lib/geo";
import { siteOrigin } from "../lib/site";

const menu = buildMenuModel();
const pairMovers = await buildPairMovers();
const locale = resolveVisitorLocale(Astro.request, Astro.cookies.get("site_lang")?.value);

// The six majors first, then everything else, so the cards that render above
// the fold are the ones most visitors came for.
const currencies = [
  ...MAJOR_COLUMNS.filter((code) => configCurrencies().includes(code)),
  ...configCurrencies().filter((code) => !MAJOR_COLUMNS.includes(code)),
];
const EAGER_CARDS = MAJOR_COLUMNS.length;

// Thumbnail-sized charts, so the full 24H window is downsampled rather than
// shipped point for point — see the maxPoints note in buildHeroChart.
const CARD_CHART_POINTS = 60;

// Every currency is measured against USD, the one quote they all share; USD
// itself against EUR. mapLimited rather than Promise.all for the reason the
// home page uses it: the pair histories behind these are memoised and shared
// with the home page, but a cold render should not open twenty reads at once.
const cards = await mapLimited(currencies, async (code) => {
  const reference = code === "USD" ? "EUR" : "USD";
  const chart = await buildHeroChart(code, reference, CARD_CHART_POINTS);
  return {
    code,
    reference,
    chart,
    profile: currencyProfile(code),
    secondary: chart ? await buildHeroSecondary(code, reference, 3) : [],
  };
});

const title = "Rate Analysis by Currency";
const description = `24-hour movement for ${currencies.length} currencies, each linking to its own rate hub `
  + `with charts, high-low statistics and trend notes on every pair.`;

const siteBaseUrl = siteOrigin(Astro.request, Astro.url);
const extraSchemaNodes = [
  {
    "@type": "ItemList",
    "@id": `${siteBaseUrl}/analysis#currencies`,
    name: "Currencies with rate analysis",
    numberOfItems: cards.length,
    itemListElement: cards.map((card, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: `${card.code} analysis`,
      url: siteBaseUrl + currencyUrl(card.code),
    })),
  },
];

// No rate sort here: each card quotes its currency against USD (USD against
// EUR), so the numbers sit on different scales and ordering them would compare
// nothing. `order` is the majors-first order the cards are built in.
const ANALYSIS_SORT_OPTIONS = [
  { value: "order-asc", label: "Default" },
  { value: "code-asc", label: "Currency A-Z" },
  { value: "code-desc", label: "Currency Z-A" },
  { value: "change-desc", label: "24H change: high to low" },
  { value: "change-asc", label: "24H change: low to high" },
];

const upColor = "#34d399";
const downColor = "#ff4d6d";
const flatColor = "#a79fa0";
const lineColor = (direction?: "up" | "down" | "flat") =>
  direction === "up" ? upColor : direction === "down" ? downColor : flatColor;
---

<Layout
  title={title}
  description={description}
  path="/analysis"
  breadcrumbName="Analysis"
  extraSchemaNodes={extraSchemaNodes}
>
  <div>
    <Header pairMovers={pairMovers} active="Analysis" autoLang={locale.lang} />

    <div class="page-pad section-pad" style="background:radial-gradient(1100px 560px at 82% -10%, rgba(225,29,63,0.22), transparent 60%), #0c0b0d; padding:48px 40px 80px; font-family:'Manrope', Arial, sans-serif;">
      <div style="max-width:1160px; margin:0 auto;">

        <nav aria-label="Breadcrumb" style="font-size:13px; color:#8b857f; margin-bottom:18px;">
          <a href="/" style="color:#8b857f;">Exchange Rates</a>
          <span style="margin:0 8px;">/</span>
          <span style="color:#f5f2f1;">Analysis</span>
        </nav>

        <h1 class="lead-title" style="font-family:'Space Grotesk', Arial, sans-serif; font-size:38px; color:#f5f2f1; margin:0 0 12px; line-height:1.1;">
          Rate analysis by currency
        </h1>
        <p style="font-size:16px; line-height:1.7; color:#a79fa0; margin:0 0 34px; max-width:780px;">
          All {currencies.length} tracked currencies with their movement over the last 24 hours. Open
          one to reach every pair under it — each pair page carries a converter, a chart with
          selectable ranges, high-low statistics over the stored window, the reverse quote and notes
          on how to read it.
        </p>

        <div style="margin-bottom:22px;">
          <SortFilterBar id="analysis-sf" options={ANALYSIS_SORT_OPTIONS} placeholder="Filter currencies..." />
        </div>

        <div id="analysis-grid" style="display:grid; grid-template-columns:repeat(auto-fill,minmax(320px,1fr)); gap:18px;">
          {cards.map(({ code, reference, chart, profile, secondary }, index) => {
            const flag = flagSrc(code);
            const stroke = lineColor(chart?.direction);
            const fillId = `analysisFill-${code}`;
            return (
              <div
                class="analysis-card"
                data-extra={index >= EAGER_CARDS ? "true" : "false"}
                data-sf-search={`${code} ${profile.name}`.toLowerCase()}
                data-sf-code={code}
                data-sf-change={chart ? chart.changePct : ""}
                hidden={index >= EAGER_CARDS}
                style="background:rgba(255,255,255,0.04); border:1px solid #2a2426; border-radius:20px; padding:24px;"
              >
                <div style="display:flex; justify-content:space-between; align-items:center;">
                  <a href={currencyUrl(code)} translate="no" style="font-size:13px; font-weight:600; color:#a79fa0; display:inline-flex; align-items:center; gap:2px;">
                    {flag && <img src={flag} alt="" width="18" height="18" style="display:block; border-radius:3px; margin-right:6px;" loading="lazy" decoding="async" />}
                    {code}
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" style="display:inline-block; vertical-align:-2px; margin:0 3px;" set:html={SWAP_ICON} />
                    {reference}
                  </a>
                  <span translate="no" style="font-size:11px; color:#a79fa0; background:rgba(255,255,255,0.06); padding:4px 9px; border-radius:999px;">24H</span>
                </div>

                {chart ? (
                  <>
                    <div style="display:flex; align-items:baseline; gap:10px; margin-top:14px;">
                      <span translate="no" style="font-family:'Space Grotesk', Arial, sans-serif; font-size:34px; font-weight:700; color:#f5f2f1;">{chart.rate}</span>
                      <span
                        translate="no"
                        style={`display:inline-flex; align-items:center; gap:4px; color:${stroke}; font-size:13px; font-weight:600; background:${chart.direction === "up" ? "rgba(52,211,153,0.14)" : chart.direction === "down" ? "rgba(225,29,63,0.14)" : "rgba(255,255,255,.06)"}; padding:4px 9px; border-radius:999px;`}
                      >
                        <svg
                          width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
                          style={`${chart.direction === "down" ? "transform:rotate(180deg);" : ""}${chart.direction === "flat" ? "display:none;" : ""}`}
                          set:html={ARROW_UP}
                        />
                        {chart.changeLabel}
                      </span>
                    </div>

                    <div style="position:relative; margin-top:18px;">
                      <svg width="100%" height="76" viewBox="0 0 400 88" style="display:block;" preserveAspectRatio="none">
                        <defs>
                          <linearGradient id={fillId} x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0" stop-color="#e11d3f" stop-opacity="0.35" />
                            <stop offset="1" stop-color="#e11d3f" stop-opacity="0" />
                          </linearGradient>
                        </defs>
                        <polygon points={`0,88 ${chart.points} 400,88`} fill={`url(#${fillId})`} />
                        <polyline points={chart.points} fill="none" stroke={stroke} stroke-width="2.5" />
                      </svg>
                      <span
                        style={`position:absolute; right:0; top:${chart.dotY}%; transform:translate(50%,-50%); width:9px; height:9px; border-radius:50%; background:${upColor}; box-shadow:0 0 0 3px rgba(52,211,153,0.25), 0 0 12px 3px rgba(52,211,153,0.65);`}
                      ></span>
                    </div>
                  </>
                ) : (
                  <div style="font-size:13.5px; color:#8b857f; margin:18px 0;">
                    No stored history for {profile.name} yet — the fetcher fills this in on its next cycle.
                  </div>
                )}

                {secondary.length > 0 && (
                  <div class="rate-card-row" style={`display:grid; grid-template-columns:repeat(${secondary.length},minmax(0,1fr)); gap:10px; margin-top:20px;`}>
                    {secondary.map((item) => (
                      <a href={item.href} class="rate-card">
                        <div translate="no" class="rate-card-label">{item.label}</div>
                        <div translate="no" class="rate-card-value">{item.rate}</div>
                      </a>
                    ))}
                  </div>
                )}

                <a href={currencyUrl(code)} style="display:block; margin-top:16px; font-size:12.5px; color:#e11d3f;">
                  All {code} pairs →
                </a>
              </div>
            );
          })}
        </div>

        <p id="analysis-empty" hidden style="font-size:15px; color:#a79fa0; margin:18px 0 0;">
          No currencies match your filter.
        </p>

        {cards.length > EAGER_CARDS && (
          <div style="text-align:center; margin-top:28px;">
            <button
              id="analysis-show-more"
              type="button"
              style="height:46px; padding:0 26px; border-radius:999px; font-weight:600; font-size:15px; cursor:pointer; background:transparent; color:#fff; border:1.5px solid #2a2426; font-family:'Manrope', Arial, sans-serif;"
            >
              Show {cards.length - EAGER_CARDS} more currencies
            </button>
          </div>
        )}

      </div>
    </div>

    <Footer menu={menu} />
    <BackToTop />
  </div>
</Layout>

<script>
  import { wireSortFilter } from "../scripts/sort-filter";

  // Every card is in the HTML — the button only defers paint and layout for the
  // ones below the majors, so a crawler still reads all of them and no second
  // request is needed. Without JS the button never appears and the extra cards
  // stay hidden, so the fallback is a shorter page rather than a broken one.
  const button = document.getElementById("analysis-show-more");
  const extras = Array.from(document.querySelectorAll<HTMLElement>('.analysis-card[data-extra="true"]'));
  const revealExtras = () => {
    for (const card of extras) card.hidden = false;
    button?.remove();
  };
  button?.addEventListener("click", revealExtras);

  const grid = document.getElementById("analysis-grid");
  const empty = document.getElementById("analysis-empty");
  if (grid) {
    wireSortFilter({
      bar: document.getElementById("analysis-sf"),
      container: grid,
      itemSelector: ".analysis-card",
      countNoun: "currencies",
      // Sorting or filtering half a list is misleading — the biggest mover may
      // well be one of the cards still folded away — so the first use of the
      // bar opens the full set and retires the button.
      onInput: revealExtras,
      onApply: (matched, all) => {
        for (const card of all) card.hidden = true;
        for (const card of matched) card.hidden = false;
        if (empty) empty.hidden = matched.length > 0;
      },
    });
  }
</script>
