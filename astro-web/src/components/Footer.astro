---
import type { MenuModel } from "../lib/menu";
import { SWAP_ICON } from "../lib/flags";
import { INFO_LINKS } from "../lib/info";

interface Props {
  menu: MenuModel;
  /** Fourth column: the tool shortcuts on data pages, the policy pages on the
   *  policy pages themselves (both footers are drawn in the design canvas).
   *  Whichever one is not shown as a column goes in the bottom bar, so every
   *  page links to the policy pages exactly once. */
  secondary?: "tools" | "company";
}

const { menu, secondary = "tools" } = Astro.props;
const popularPairs = menu.footerLinks.slice(0, 4);
const crossRates = menu.footerLinks.slice(4, 8);
// `pair: true` keeps a label out of Google Translate's hands — a currency
// code turned into its full name ("USD" -> "đô la Mỹ") is both wrong and
// several times longer than the slot it sits in.
const tools = [
  { label: "Exchange rates dashboard", href: "/", pair: false },
  { label: "USD to VND", href: "/usd-vnd", pair: true },
  { label: "VND to USD", href: "/vnd-usd", pair: true },
  { label: "EUR to USD", href: "/eur-usd", pair: true },
];
const secondaryColumn = secondary === "company"
  ? { title: "Company", links: INFO_LINKS.map((link) => ({ ...link, pair: false })) }
  : { title: "Tools", links: tools };
const bottomLinks = secondary === "company" ? [] : INFO_LINKS;
---

<div style="border-top:1px solid #2a2426; background:#0c0b0d; font-family:'Manrope', Arial, sans-serif;">
  <div style="max-width:1180px; margin:0 auto; padding:48px 40px 22px;">
    <div style="display:grid; grid-template-columns:minmax(260px,1.25fr) repeat(3,minmax(180px,1fr)); gap:32px; align-items:start;">
      <div>
        <div style="display:inline-flex; align-items:center; margin-bottom:14px;">
          <a href="/"><img src="/ratehub-2c-trimmed.png" alt="ExchangeHub - live FX rates & conversion" style="height:78px; width:auto; display:block;" /></a>
        </div>
        <p style="color:#a79fa0; line-height:1.6; margin:0 0 10px; font-size:14px;">Currency converters, pair charts, indexed dashboards, and exchange-rate explainers built for quick comparison and market context.</p>
        <p style="font-size:13px; color:#6f6864; margin:0;">Rates are informational mid-market references. Banks, brokers, card networks, and transfer providers may apply spreads, fees, and settlement rules.</p>
      </div>
      <div>
        <h2 style="margin:0 0 8px; font-size:13px; color:#f5f2f1; font-weight:700; text-transform:uppercase; letter-spacing:.05em;">Popular pairs</h2>
        <div style="width:22px; height:2px; background:#e11d3f; margin-bottom:14px;"></div>
        <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(100px,1fr)); gap:8px;">
          {popularPairs.map((link) => {
            const [base, target] = link.label.split(" to ");
            return (
              <a translate="no" href={link.href} style="display:block; border:1px solid #2a2426; border-radius:10px; background:#151315; color:#e4dfdc; font-size:13px; font-weight:500; padding:9px 12px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                {base}
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" style="display:inline-block; vertical-align:-2px; margin:0 3px;" set:html={SWAP_ICON} />
                {target}
              </a>
            );
          })}
        </div>
      </div>
      <div>
        <h2 style="margin:0 0 8px; font-size:13px; color:#f5f2f1; font-weight:700; text-transform:uppercase; letter-spacing:.05em;">Cross rates</h2>
        <div style="width:22px; height:2px; background:#e11d3f; margin-bottom:14px;"></div>
        <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(100px,1fr)); gap:8px;">
          {crossRates.map((link) => {
            const [base, target] = link.label.split(" to ");
            return (
              <a translate="no" href={link.href} style="display:block; border:1px solid #2a2426; border-radius:10px; background:#151315; color:#e4dfdc; font-size:13px; font-weight:500; padding:9px 12px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                {base}
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" style="display:inline-block; vertical-align:-2px; margin:0 3px;" set:html={SWAP_ICON} />
                {target}
              </a>
            );
          })}
        </div>
      </div>
      <div>
        <h2 style="margin:0 0 8px; font-size:13px; color:#f5f2f1; font-weight:700; text-transform:uppercase; letter-spacing:.05em;">{secondaryColumn.title}</h2>
        <div style="width:22px; height:2px; background:#e11d3f; margin-bottom:14px;"></div>
        <div style="display:flex; flex-direction:column; gap:11px;">
          {secondaryColumn.links.map((link) => (
            <a href={link.href} translate={link.pair ? "no" : undefined} style="display:flex; align-items:center; gap:8px; color:#a79fa0; font-size:14px; line-height:1.35;">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#e11d3f" stroke-width="2.6" style="flex:0 0 auto;"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </div>
    {bottomLinks.length > 0 && (
      <div style="border-top:1px solid #2a2426; margin-top:32px; padding-top:16px; display:flex; gap:18px; flex-wrap:wrap; font-size:13px;">
        {bottomLinks.map((link) => (
          <a href={link.href} style="color:#a79fa0;">{link.label}</a>
        ))}
      </div>
    )}
    <div style={`border-top:1px solid #2a2426; margin-top:${bottomLinks.length > 0 ? "16px" : "32px"}; padding-top:16px; color:#6f6864; display:flex; justify-content:space-between; gap:16px; flex-wrap:wrap; font-size:13px;`}>
      <span>Built for exchange-rate comparison and reference.</span>
      <span>Not financial advice.</span>
    </div>
  </div>
</div>
