---
import { ARROW_UP } from "../lib/flags";
---

<button type="button" id="back-to-top" aria-label="Back to top" title="Back to top" hidden>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" set:html={ARROW_UP} />
</button>

<style>
  #back-to-top {
    position: fixed;
    right: 28px;
    bottom: 28px;
    z-index: 900;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 50%;
    background: #e11d3f;
    color: #fff;
    cursor: pointer;
    box-shadow: 0 10px 26px rgba(225, 29, 63, 0.32);
    /* Hidden state, so the button fades and lifts in rather than popping.
       `hidden` still takes it out of the layout between fades — the script
       flips it a frame either side of the class. */
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      background-color 0.18s ease,
      box-shadow 0.18s ease;
  }
  #back-to-top[data-shown='true'] {
    opacity: 1;
    transform: none;
  }
  #back-to-top:hover {
    background: #c4132f;
    box-shadow: 0 12px 30px rgba(225, 29, 63, 0.42);
  }
  #back-to-top:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    #back-to-top {
      transition: none;
    }
  }
</style>

<script>
  (function () {
    const button = document.getElementById("back-to-top");
    if (!button) return;
    const reduceMotion = typeof window.matchMedia === "function"
      && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    // Roughly one viewport down — far enough that scrolling back is a chore,
    // so the button only shows up once it earns its place.
    const SHOW_AFTER = 600;
    let hideTimer: ReturnType<typeof setTimeout> | null = null;

    // An arrow const rather than a hoisted `function`: a function declaration
    // could in principle run before the `if (!button) return` above it, so
    // TypeScript drops the narrowing inside one and calls `button` nullable.
    const sync = () => {
      const shouldShow = window.scrollY > SHOW_AFTER;
      if (shouldShow) {
        if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }
        if (button.hidden) {
          button.hidden = false;
          requestAnimationFrame(() => { button.dataset.shown = "true"; });
        } else {
          button.dataset.shown = "true";
        }
      } else if (button.dataset.shown === "true") {
        button.dataset.shown = "false";
        if (hideTimer) clearTimeout(hideTimer);
        hideTimer = setTimeout(() => { button.hidden = true; }, reduceMotion ? 0 : 200);
      }
    };

    button.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: reduceMotion ? "auto" : "smooth" });
    });
    window.addEventListener("scroll", sync, { passive: true });
    sync();
  })();
</script>
